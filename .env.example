# Supabase — get these from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 — create an S3 API token with Object Read & Write only.
# Keep these server-only: do not prefix them with NEXT_PUBLIC_.
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=prisma-spk-documents

# Adobe PDF Embed API — public Client ID, restricted by the registered domains.
NEXT_PUBLIC_ADOBE_PDF_EMBED_CLIENT_ID=your-adobe-pdf-embed-client-id

# Optional — for local Supabase CLI development (supabase start)
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
