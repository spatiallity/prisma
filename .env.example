# Supabase — get these from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Base URL untuk password reset (optional — defaults to localhost:3000 in dev, VERCEL_URL in prod)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional — for local Supabase CLI development (supabase start)
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
